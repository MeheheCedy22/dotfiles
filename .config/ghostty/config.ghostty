# ~/.config/ghostty/config

# --- Font & Cursor ---
font-family = "FiraCode Nerd Font Mono"
font-size = 12
cursor-style = underline
cursor-style-blink = true

# --- Theme ---
# Ghostty has Dracula built-in, so you don't need to manually map your hex codes!
theme = Dracula

# --- Window Dimensions ---
# Note: On Linux, tiling window managers may override these dimensions.
window-width = 150
window-height = 40

# --- Behavior & Startup ---
copy-on-select = false
selection-clear-on-copy = true


# --- Keybindings ---
# # Find/Search
# # already set by default, if i enable this, it give me an error
# keybind = ctrl+shift+f=search

# Windows-style Copy & Paste
# WARNING: See notes below regarding ctrl+c in Linux terminals.
#keybind = ctrl+shift+c=copy_to_clipboard
#keybind = ctrl+shift+v=paste_from_clipboard

keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard

# my stuff
shell-integration = detect
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Pane management
# Split pane (Ghostty's 'auto' splits based on the longest edge)
keybind = alt+shift+d=new_split
keybind = alt+shift+-=new_split:down

keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+arrow_up=scroll_page_lines:-1
keybind = ctrl+shift+arrow_down=scroll_page_lines:1

keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = alt+arrow_up=goto_split:up

keybind = alt+shift+arrow_down=resize_split:down,15
keybind = alt+shift+arrow_left=resize_split:left,15
keybind = alt+shift+arrow_right=resize_split:right,15
keybind = alt+shift+arrow_up=resize_split:up,15
